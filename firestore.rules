rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Awards Collection (Public catalog & Admin management)
    match /awards/{awardId} {
      allow read: if true;
      allow write: if true;
    }

    // Google Drive Folders collection
    match /driveFolders/{folderId} {
      allow read: if true;
      allow write: if true;
    }

    // Academic Years collection
    match /academicYears/{yearId} {
      allow read: if true;
      allow write: if true;
    }

    // Departments collection
    match /departments/{deptId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Activity Logs collection
    match /activityLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

